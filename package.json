{
  "name": "chessgroundx",
  "version": "10.7.5",
  "description": "Extended lichess.org Chess UI",
  "type": "module",
  "module": "chessground.js",
  "typings": "chessground.d.ts",
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "prepare": "pnpm run compile",
    "compile": "tsc --outDir . --sourceMap --declaration",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/*.ts tests/*.ts",
    "lint:fix": "oxlint --fix src/*.ts tests/*.ts",
    "format": "oxfmt src tests scripts vitest.config.ts",
    "check-format": "oxfmt --check tests scripts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "node scripts/check-pychess-consumer.mjs",
    "bundle": "node scripts/bundle.mjs",
    "dist": "pnpm run compile && pnpm run bundle"
  },
  "files": [
    "/*.js",
    "/*.d.ts",
    "/*.js.map",
    "/assets/*.css",
    "/src/*.ts",
    "!/rollup.config.js"
  ],
  "repository": "https://github.com/gbtami/chessgroundx",
  "keywords": [
    "chess",
    "lichess",
    "lichess.org",
    "chessboard",
    "ui",
    "typescript"
  ],
  "author": "Bajusz Tamás (https://github.com/gbtami)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/gbtami/chessgroundx/issues"
  },
  "funding": "https://pychess.org/patron",
  "packageManager": "pnpm@12.10.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
